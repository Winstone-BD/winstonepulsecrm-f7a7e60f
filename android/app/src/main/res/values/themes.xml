<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WinstoneConnect" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorBackground">@color/win_cream</item>
        <item name="android:windowBackground">@color/win_cream</item>
        <item name="android:statusBarColor">@color/win_cream</item>
        <item name="android:navigationBarColor">@color/win_cream</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- App start only (MainActivity): gold logo on white until the first screen draws. -->
    <style name="Theme.WinstoneConnect.Launch" parent="Theme.WinstoneConnect">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
